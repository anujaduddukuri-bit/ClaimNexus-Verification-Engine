# ClaimNexus Environment Variables Template
# In Production, set these environment variables in your deployment dashboard (Render/Vercel).
# NEVER commit actual API keys to Git or expose them to the frontend application.

# Provider Credentials (Server-Side Only)
XAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (PostgreSQL with pgvector for production; SQLite fallback for local dev)
DATABASE_URL=sqlite:///./claimnexus.db

# Cache Configuration (Redis for production; in-memory fallback for local dev)
REDIS_URL=redis://localhost:6379/0

# CORS & Server Settings
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:8000/api/v1
